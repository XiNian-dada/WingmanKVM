#!/bin/sh
set -eu

# This helper is installed root-owned and is only callable through the
# matching sudoers rule.  It deliberately accepts the password on stdin so
# it never appears in argv or the process list.
IFS= read -r password || true
[ -n "$password" ] || exit 2
# Bound the privileged process here: the service user cannot reliably kill a
# root-owned chpasswd after its own outer deadline expires.
printf 'wingman:%s\n' "$password" | /usr/bin/timeout --kill-after=1s 3s /usr/sbin/chpasswd
