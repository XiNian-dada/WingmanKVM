[Unit]
Description=WingmanKVM lightweight ARM KVM service
After=network-online.target wingmankvm-gadget.service
Wants=network-online.target wingmankvm-gadget.service

[Service]
Type=simple
User=wingmankvm
Group=wingmankvm
SupplementaryGroups=wingmankvm-hw
Environment=WINGMANKVM_STATE_DIR=/var/lib/wingmankvm
Environment=RUST_LOG=wingmankvm=info
ExecStart=/usr/local/bin/wingmankvm
Restart=on-failure
RestartSec=2s
PrivateTmp=true
ProtectSystem=strict
# sudo keeps terminal authentication timestamps under /run/sudo.  The web
# terminal inherits this mount namespace, so keep that narrowly scoped path
# writable. The fixed, root-owned password helper also needs /etc for shadow
# updates and its lock file; the unprivileged service user still has normal
# Unix permission checks.
ReadWritePaths=/var/lib/wingmankvm /run/sudo /etc -/sys/kernel/config/usb_gadget

[Install]
WantedBy=multi-user.target
